# Öffentliche Site-URL. Pflicht in Produktion – sonst zeigen Auth-Mails auf localhost.
NEXT_PUBLIC_SITE_URL=https://www.sitov-academy.com

# Supabase-Projekt SmartGerman v2 (wcaslabeiwtvygxtzcio)
# Die NEXT_PUBLIC_-Namen müssen gesetzt sein, weil der Browser-Client sie einbindet.
# WICHTIG (Vercel/Netlify): Beide Variablen müssen zur BUILD-ZEIT verfügbar sein,
# nicht erst zur Laufzeit – Next.js brennt sie beim Bauen fest ins Client-Bundle ein.
# In Vercel als "Shared" Environment Variable anlegen und für den Build-Schritt
# freigeben; bei Netlify (@netlify/plugin-nextjs) gilt dieselbe Regel.
NEXT_PUBLIC_SUPABASE_URL=https://wcaslabeiwtvygxtzcio.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Aliase, falls im Hosting-Dashboard so benannt (optional, Fallback im Code):
# SUPABASE_URL=https://wcaslabeiwtvygxtzcio.supabase.co
# SUPABASE_ANON_KEY=

# Nur serverseitig, niemals NEXT_PUBLIC_ und niemals ins Git:
# SUPABASE_SERVICE_ROLE_KEY=
